# ─────────────────────────────────────────────────────────────────────────────
#  O'Connors AI Platform — Local Environment Variables
#  Copy this file to .env and fill in the values before running docker compose.
#
#  cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=aiplatform
POSTGRES_USER=aiplatform
POSTGRES_PASSWORD=aiplatform_secret

# ── Elasticsearch / Kibana ────────────────────────────────────────────────────
ELASTIC_PASSWORD=elastic_secret

# ── Azure AD (required — the system uses Azure AD for authentication) ─────────
# Get these from the Azure Portal → App Registrations
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-backend-app-client-id
AZURE_CLIENT_SECRET=your-backend-app-client-secret

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 32 characters long.
# For local, any random string works. In production this is stored in Key Vault.
JWT_SECRET=local_dev_jwt_secret_change_this_to_something_random
JWT_ISSUER_URI=https://login.microsoftonline.com/your-azure-tenant-id/v2.0
JWT_ACCESS_TOKEN_EXPIRY=900
JWT_REFRESH_TOKEN_EXPIRY=604800

# ── SharePoint (required for document-service and etl-service) ────────────────
# These are the credentials of the Azure AD app that has SharePoint access.
# May be the same as AZURE_CLIENT_ID/SECRET if the same app is used.
SHAREPOINT_CLIENT_ID=your-sharepoint-app-client-id
SHAREPOINT_CLIENT_SECRET=your-sharepoint-app-client-secret

# ── LLM (Ollama is the default for local — no extra config needed) ────────────
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b

# Optional: Use Azure AI Foundry instead of Ollama
# LLM_PROVIDER=azure-foundry
# AZURE_FOUNDRY_KEY=your-azure-ai-foundry-key
# AZURE_FOUNDRY_ENDPOINT=https://your-endpoint.services.ai.azure.com/openai/v1/
# AZURE_FOUNDRY_MODEL=mistral-small-2503

# ── ChromaDB Collection ───────────────────────────────────────────────────────
COLLECTION_NAME=oconnors_ims
EMBEDDING_MODEL=BAAI/bge-m3

# ── RAG Settings ──────────────────────────────────────────────────────────────
# RAG_DOMAIN — restrict retrieval to a SharePoint subfolder (IMS or Service).
# Leave empty to search all ingested documents.
RAG_DOMAIN=
RAG_RETRIEVAL_K=30
RAG_TOP_K=5

# ── Frontend (user-interface build args) ──────────────────────────────────────
# The SPA client registration in Azure AD (may differ from the backend app).
VITE_AZURE_CLIENT_ID=your-spa-azure-client-id
VITE_AZURE_AUTHORITY=https://login.microsoftonline.com/your-azure-tenant-id
VITE_AZURE_REDIRECT_URI=http://localhost:3000
VITE_AZURE_SCOPE=api://your-backend-app-client-id/access_as_user
VITE_AUTH_SERVICE_URL=http://localhost:8000
VITE_CHAT_SERVICE_URL=http://localhost:8000
VITE_DOCUMENT_SERVICE_URL=http://localhost:8000

# ── ETL Service (only needed when running the ETL profile) ───────────────────
PIPELINE_MODE=live
SHAREPOINT_TARGET_FOLDER=IMS
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
