    <diagram id="d2" name="2 - Communication Protocols">
        <mxGraphModel dx="403" dy="615" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="850" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="2" value="Communication Protocol Design" style="text;html=1;fontSize=18;fontStyle=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="200" y="20" width="750" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="2b" value="Each communication layer uses the protocol best suited to its traffic pattern." style="text;html=1;fontSize=11;align=center;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="150" y="54" width="850" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="3" value="① HTTPS / REST" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#0078d4;fontColor=#0078d4;fontStyle=1;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="20" y="105" width="145" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="4" value="&lt;b&gt;Browser&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="195" y="105" width="110" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="5" value="&lt;b&gt;Kong&lt;/b&gt;&lt;br&gt;API Gateway" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="365" y="105" width="110" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="6" value="Authentication Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="535" y="83" width="175" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="7" value="Document Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="535" y="129" width="175" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="8" value="Chat Service (REST sessions)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="535" y="175" width="175" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="9" value="&lt;b&gt;Why HTTPS/REST?&lt;/b&gt;&lt;br&gt;• Stateless request-response model&lt;br&gt;• Universal browser support (RFC 9110)&lt;br&gt;• TLS 1.3 encryption (RFC 8446)&lt;br&gt;• Standard JSON API (Fielding, 2000)&lt;br&gt;• Kong manages TLS termination" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9f9ff;strokeColor=#0078d4;fontSize=10;align=left;" parent="1" vertex="1">
                    <mxGeometry x="740" y="80" width="270" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="10" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0078d4;strokeWidth=2;fontColor=#0078d4;fontStyle=1;fontSize=10;endArrow=block;endFill=1;" parent="1" source="4" target="5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="11" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0078d4;strokeWidth=2;fontColor=#0078d4;fontStyle=1;fontSize=9;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" parent="1" source="5" target="6" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="12" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0078d4;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="5" target="8" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="13" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0078d4;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" parent="1" source="5" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="530" y="150" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="20" value="② WebSocket / STOMP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#00b294;fontColor=#00594d;fontStyle=1;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="20" y="275" width="145" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="21" value="&lt;b&gt;Browser&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="195" y="275" width="110" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="22" value="&lt;b&gt;Kong&lt;/b&gt;&lt;br&gt;API Gateway" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="365" y="275" width="110" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="23" value="&lt;b&gt;Chat Service&lt;/b&gt;&lt;br&gt;Spring Boot · STOMP broker&lt;br&gt;/ws endpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="535" y="265" width="175" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="24" value="&lt;b&gt;Why WebSocket/STOMP?&lt;/b&gt;&lt;br&gt;• Full-duplex — server pushes responses&lt;br&gt;• No polling overhead (RFC 6455)&lt;br&gt;• 500–750× less traffic vs HTTP polling&lt;br&gt;  (Pimentel &amp;amp; Nickerson, 2012)&lt;br&gt;• Persistent connection for chat session&lt;br&gt;• STOMP provides pub/sub routing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9f9ff;strokeColor=#00b294;fontSize=10;align=left;" parent="1" vertex="1">
                    <mxGeometry x="740" y="250" width="270" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="25" value="WSS (upgrade)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#00b294;strokeWidth=2;fontColor=#00594d;fontStyle=1;fontSize=10;endArrow=block;endFill=1;" parent="1" source="21" target="22" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="26" value="WSS / STOMP" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#00b294;strokeWidth=2;fontColor=#00594d;fontStyle=1;fontSize=10;endArrow=block;endFill=1;" parent="1" source="22" target="23" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="30" value="③ gRPC (HTTP/2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce5d4;strokeColor=#e65100;fontColor=#e65100;fontStyle=1;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="20" y="440" width="145" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="31" value="Azure Container Apps — internal network" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;fontSize=9;fontColor=#666666;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="185" y="425" width="530" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="32" value="&lt;b&gt;Chat Service&lt;/b&gt;&lt;br&gt;(gRPC client)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="205" y="450" width="155" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="33" value="&lt;b&gt;Chatbot Service&lt;/b&gt;&lt;br&gt;Python · :50051&lt;br&gt;&lt;font color=&#39;#cc0000&#39;&gt;No public route&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="540" y="445" width="155" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="34" value="&lt;b&gt;Why gRPC?&lt;/b&gt;&lt;br&gt;• Binary protobuf: 7–10× faster than JSON&lt;br&gt;  (Venkataraman et al., 2018)&lt;br&gt;• Type-safe .proto contract (cross-language)&lt;br&gt;• HTTP/2 multiplexing&lt;br&gt;• Server-streaming ready (future token streaming)&lt;br&gt;• Internal only — no browser compat needed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9f9ff;strokeColor=#e65100;fontSize=10;align=left;" parent="1" vertex="1">
                    <mxGeometry x="740" y="420" width="270" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="35" value="gRPC :50051  (InferenceRequest / InferenceReply)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#e65100;strokeWidth=2;fontColor=#e65100;fontStyle=1;fontSize=10;endArrow=block;endFill=1;" parent="1" source="32" target="33" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="d3" name="3 - Security Architecture">
        <mxGraphModel dx="1096" dy="1118" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="2" value="Security Architecture — Defence in Depth (5 Layers)" style="text;html=1;fontSize=18;fontStyle=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="100" y="20" width="800" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="3" value="Layer 1: Transport Security (TLS 1.3 — RFC 8446)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f4fd;strokeColor=#2196F3;strokeWidth=3;fontSize=12;fontStyle=1;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="50" y="70" width="920" height="750" as="geometry"/>
                </mxCell>
                <mxCell id="3b" value="All public HTTPS and WSS traffic encrypted in transit. Azure Container Apps manages TLS certificates automatically. Clients connecting over plain HTTP are redirected to HTTPS." style="text;html=1;fontSize=10;fontColor=#1565C0;align=left;" parent="1" vertex="1">
                    <mxGeometry x="65" y="100" width="890" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="4" value="Layer 2: API Gateway — Rate Limiting · CORS (Kong 3.7)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#9673a6;strokeWidth=3;fontSize=12;fontStyle=1;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="80" y="155" width="860" height="640" as="geometry"/>
                </mxCell>
                <mxCell id="4b" value="Single public ingress. Rate limiting prevents brute-force and DoS: 20 req/min (auth), 60 req/min (chat), 30 req/min (documents). CORS restricts allowed origins and methods. Chatbot service has no public route — only reachable internally via gRPC." style="text;html=1;fontSize=10;fontColor=#6A1B9A;align=left;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="96" y="186" width="828" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="5" value="Layer 3: Identity — Azure AD · Platform JWT (HS256)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#FF9800;strokeWidth=3;fontSize=12;fontStyle=1;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="110" y="245" width="800" height="520" as="geometry"/>
                </mxCell>
                <mxCell id="5b" value="Users authenticate via Azure AD (PKCE flow). Auth-service exchanges Azure JWT for a short-lived platform access JWT (15 min, HS256). Refresh tokens are stored as SHA-256 hashes — plaintext is never persisted. Token rotation: each refresh token is single-use; old token revoked before new one issued." style="text;html=1;fontSize=10;fontColor=#E65100;align=left;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="126" y="276" width="768" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="6" value="Layer 4: Service-Level Authorisation — Spring Security OAuth2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976D2;strokeWidth=3;fontSize=12;fontStyle=1;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="140" y="340" width="740" height="400" as="geometry"/>
                </mxCell>
                <mxCell id="6b" value="Every Spring Boot service (auth, chat, document) independently validates the platform JWT on every request using the shared-security library. Validates: HS256 signature, issuer (oconnor-platform), expiry. Role-based access control via @PreAuthorize annotations. WebSocket handshake also validated before connection is established." style="text;html=1;fontSize=10;fontColor=#0D47A1;align=left;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="156" y="370" width="708" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="7" value="Layer 5: Network Isolation — Azure Container Apps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#388E3C;strokeWidth=3;fontSize=12;fontStyle=1;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="170" y="440" width="680" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="7b" value="All backend services: external = false" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388E3C;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="190" y="490" width="300" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="7c" value="Chatbot service: internal gRPC only — no public URL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388E3C;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="500" y="490" width="330" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="7d" value="Secrets (JWT_SECRET, Azure credentials) stored in Azure Key Vault — never in plain environment variables" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388E3C;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="190" y="545" width="640" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="7e" value="Kong is the only container with external: true — all inter-service calls use Azure internal DNS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388E3C;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="190" y="600" width="640" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="7f" value="Refresh tokens hashed with SHA-256 before storage — database breach cannot expose plaintext tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388E3C;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="190" y="655" width="640" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="8" value="OUTERMOST" style="text;html=1;fontSize=9;fontColor=#2196F3;fontStyle=1;rotation=-90;" parent="1" vertex="1">
                    <mxGeometry x="18" y="450" width="85" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="9" value="INNERMOST" style="text;html=1;fontSize=9;fontColor=#388E3C;fontStyle=1;rotation=-90;" parent="1" vertex="1">
                    <mxGeometry x="148" y="600" width="85" height="20" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="d4" name="4 - Auth Sequence">
        <mxGraphModel dx="1206" dy="1230" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="850" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="2" value="Authentication Flow — Token Exchange Sequence" style="text;html=1;fontSize=18;fontStyle=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="100" y="20" width="900" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="10" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;Vue 3 + MSAL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="50" y="65" width="130" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="11" value="&lt;b&gt;Kong&lt;/b&gt;&lt;br&gt;API Gateway" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="250" y="65" width="130" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="12" value="&lt;b&gt;Authentication&lt;/b&gt;&lt;br&gt;&lt;b&gt;Service&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="460" y="65" width="130" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="13" value="&lt;b&gt;Azure AD&lt;/b&gt;&lt;br&gt;(Entra ID)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="680" y="65" width="130" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="14" value="&lt;b&gt;MS Graph&lt;/b&gt;&lt;br&gt;API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="890" y="65" width="130" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="20" value="" style="endArrow=none;dashed=1;strokeColor=#aaaaaa;strokeWidth=1;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="115" y="120" as="sourcePoint"/>
                        <mxPoint x="115" y="790" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="21" value="" style="endArrow=none;dashed=1;strokeColor=#aaaaaa;strokeWidth=1;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="315" y="120" as="sourcePoint"/>
                        <mxPoint x="315" y="790" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="22" value="" style="endArrow=none;dashed=1;strokeColor=#aaaaaa;strokeWidth=1;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="525" y="120" as="sourcePoint"/>
                        <mxPoint x="525" y="790" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="23" value="" style="endArrow=none;dashed=1;strokeColor=#aaaaaa;strokeWidth=1;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="745" y="120" as="sourcePoint"/>
                        <mxPoint x="745" y="790" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="24" value="" style="endArrow=none;dashed=1;strokeColor=#aaaaaa;strokeWidth=1;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="955" y="120" as="sourcePoint"/>
                        <mxPoint x="955" y="790" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="30" value="① User opens app → Router guard checks MSAL cache → No token → Redirect to /login → User clicks Sign in → MSAL opens Azure AD PKCE popup" style="text;html=1;fontSize=9;fontColor=#555555;align=left;" parent="1" vertex="1">
                    <mxGeometry x="50" y="140" width="900" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="31" value="② POST /api/auth/token  { azureToken }" style="edgeStyle=none;html=1;strokeColor=#0078d4;strokeWidth=2;fontColor=#0078d4;fontStyle=1;fontSize=10;endArrow=block;endFill=1;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="115" y="190" as="sourcePoint"/>
                        <mxPoint x="315" y="190" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="32" value="forward request" style="edgeStyle=none;html=1;strokeColor=#9673a6;fontSize=10;endArrow=block;endFill=1;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="315" y="220" as="sourcePoint"/>
                        <mxPoint x="525" y="220" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="33" value="③ azureJwtDecoder.decode(azureToken)" style="edgeStyle=none;html=1;strokeColor=#b85450;fontSize=10;endArrow=block;endFill=1;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="525" y="260" as="sourcePoint"/>
                        <mxPoint x="745" y="260" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="34" value="④ decoded claims: sub, email, name, oid" style="edgeStyle=none;html=1;strokeColor=#b85450;fontSize=10;endArrow=open;endFill=0;dashed=1;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="745" y="295" as="sourcePoint"/>
                        <mxPoint x="525" y="295" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="35" value="⑤ GET /v1.0/users/{oid}/memberOf  (roles)" style="edgeStyle=none;html=1;strokeColor=#b85450;fontSize=10;endArrow=block;endFill=1;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="525" y="335" as="sourcePoint"/>
                        <mxPoint x="955" y="335" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="36" value="⑥ roles[ ]" style="edgeStyle=none;html=1;strokeColor=#b85450;fontSize=10;endArrow=open;endFill=0;dashed=1;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="955" y="370" as="sourcePoint"/>
                        <mxPoint x="525" y="370" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="37" value="⑦  Auth Service internal processing:" style="text;html=1;fontSize=10;fontStyle=1;align=left;" parent="1" vertex="1">
                    <mxGeometry x="430" y="400" width="280" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="37b" value="• tokenProvider.createAccessToken(userId, email, name, roles)&lt;br&gt;  → signs platform JWT (HS256, iss=oconnor-platform, 15 min)&lt;br&gt;• refreshTokenService.createAndStore(...)&lt;br&gt;  → generates UUID refresh token&lt;br&gt;  → stores SHA-256 hash in PostgreSQL (never plaintext)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9db;strokeColor=#d6b656;fontSize=10;align=left;" parent="1" vertex="1">
                    <mxGeometry x="430" y="424" width="480" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="38" value="⑧ TokenResponse { accessToken, refreshToken, expiresIn }" style="edgeStyle=none;html=1;strokeColor=#0078d4;fontSize=10;endArrow=open;endFill=0;dashed=1;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="525" y="530" as="sourcePoint"/>
                        <mxPoint x="315" y="530" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="39" value="⑨ { accessToken, refreshToken, expiresIn }" style="edgeStyle=none;html=1;strokeColor=#0078d4;strokeWidth=2;fontColor=#0078d4;fontStyle=1;fontSize=10;endArrow=open;endFill=0;dashed=1;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="315" y="560" as="sourcePoint"/>
                        <mxPoint x="115" y="560" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="40" value="⑩ All subsequent API requests carry:  Authorization: Bearer &lt;accessToken&gt;&lt;br&gt;Each Spring Boot service validates the JWT independently (signature + expiry + issuer)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f4fd;strokeColor=#2196F3;fontSize=10;align=left;" parent="1" vertex="1">
                    <mxGeometry x="50" y="600" width="900" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="41" value="Token Refresh Flow (when access token expires or 401 received):" style="text;html=1;fontSize=11;fontStyle=1;align=left;" parent="1" vertex="1">
                    <mxGeometry x="50" y="670" width="500" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="42" value="POST /api/auth/refresh { refreshToken }" style="edgeStyle=none;html=1;strokeColor=#0078d4;strokeWidth=2;fontColor=#0078d4;fontStyle=1;fontSize=10;endArrow=block;endFill=1;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="115" y="710" as="sourcePoint"/>
                        <mxPoint x="315" y="710" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="43" value="forward" style="edgeStyle=none;html=1;strokeColor=#9673a6;fontSize=10;endArrow=block;endFill=1;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="315" y="710" as="sourcePoint"/>
                        <mxPoint x="525" y="710" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="44" value="validate hash → revoke old token → issue new token pair" style="text;html=1;fontSize=9;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="430" y="720" width="380" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="45" value="{ new accessToken, new refreshToken }" style="edgeStyle=none;html=1;strokeColor=#0078d4;fontSize=10;endArrow=open;endFill=0;dashed=1;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="315" y="750" as="sourcePoint"/>
                        <mxPoint x="115" y="750" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="d5" name="5 - Deployment (Azure)">
        <mxGraphModel dx="1340" dy="1367" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="2" value="Deployment Architecture — Azure Container Apps" style="text;html=1;fontSize=18;fontStyle=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="150" y="20" width="950" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="3" value="&lt;b&gt;Bitbucket&lt;/b&gt;&lt;br&gt;Source + Pipelines&lt;br&gt;&lt;font size=&#39;2&#39;&gt;per-service CI/CD&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#0052cc;fontColor=#0052cc;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="80" y="80" width="170" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="4" value="&lt;b&gt;Azure Container Registry&lt;/b&gt;&lt;br&gt;oconnoraiplatform.azurecr.io&lt;br&gt;&lt;font size=&#39;2&#39;&gt;Docker image store&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0a30a;strokeColor=#BD7000;fontColor=#000000;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="340" y="80" width="200" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="5" value="build + push image" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0052cc;strokeWidth=2;fontColor=#0052cc;fontStyle=1;fontSize=10;endArrow=block;endFill=1;" parent="1" source="3" target="4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="6" value="Azure Container Apps Environment&lt;br&gt;proudground-90080d26.australiaeast.azurecontainerapps.io" style="swimlane;startSize=45;rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f4fd;strokeColor=#0078d4;strokeWidth=3;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="200" width="1000" height="680" as="geometry"/>
                </mxCell>
                <mxCell id="7" value="&lt;b&gt;kong-gateway&lt;/b&gt;&lt;br&gt;Kong 3.7 · DB-less&lt;br&gt;&lt;font color=&#39;#006600&#39;&gt;external: true ✓&lt;/font&gt;&lt;br&gt;&lt;font size=&#39;2&#39;&gt;Public HTTPS/WSS ingress&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=10;" parent="6" vertex="1">
                    <mxGeometry x="30" y="60" width="200" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="8" value="&lt;b&gt;user-interface&lt;/b&gt;&lt;br&gt;Vue 3 · Nginx&lt;br&gt;&lt;font color=&#39;#006600&#39;&gt;external: true ✓&lt;/font&gt;&lt;br&gt;&lt;font size=&#39;2&#39;&gt;SPA static file server&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" parent="6" vertex="1">
                    <mxGeometry x="260" y="60" width="200" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="8b" value="← Public endpoints" style="text;html=1;fontSize=10;fontColor=#006600;fontStyle=1;" parent="6" vertex="1">
                    <mxGeometry x="480" y="93" width="150" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="9" value="&lt;b&gt;authentication-service&lt;/b&gt;&lt;br&gt;Spring Boot 4 · Java 21&lt;br&gt;&lt;font color=&#39;#cc0000&#39;&gt;external: false&lt;/font&gt;&lt;br&gt;Port 8080" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" parent="6" vertex="1">
                    <mxGeometry x="30" y="195" width="200" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="10" value="&lt;b&gt;chat-service&lt;/b&gt;&lt;br&gt;Spring Boot 4 · Java 21&lt;br&gt;&lt;font color=&#39;#cc0000&#39;&gt;external: false&lt;/font&gt;&lt;br&gt;Port 8080 + WS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" parent="6" vertex="1">
                    <mxGeometry x="260" y="195" width="200" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="11" value="&lt;b&gt;document-service&lt;/b&gt;&lt;br&gt;Spring Boot 4 · Java 21&lt;br&gt;&lt;font color=&#39;#cc0000&#39;&gt;external: false&lt;/font&gt;&lt;br&gt;Port 8080" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" parent="6" vertex="1">
                    <mxGeometry x="490" y="195" width="200" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="12" value="&lt;b&gt;chatbot-service&lt;/b&gt;&lt;br&gt;Python · gRPC :50051&lt;br&gt;&lt;font color=&#39;#cc0000&#39;&gt;external: false&lt;/font&gt;&lt;br&gt;&lt;font color=&#39;#cc0000&#39;&gt;No public route — internal gRPC only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="6" vertex="1">
